{
  "manifest_version": 3,
  "name": "Dayday Browser Context",
  "version": "0.1.0",
  "description": "Provides a local, non-incognito safety signal for Dayday screen understanding.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "webNavigation", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Dayday Browser Context"
  }
}
